
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikTok Growth Studio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <nav class="navbar">
    <div class="logo">🚀 TikTok Studio</div>

    <div class="nav-links">
        <a href="#">Home</a>
        <a href="#tools">Tools</a>
        <a href="#dashboard">Dashboard</a>
    </div>
</nav>
        <h1>🚀 TikTok Growth Studio</h1>
        <p>Your Free TikTok Growth Tools</p>
    </header>
<section class="card">
    <h2>💡 Video Ideas Generator</h2>

    <select id="category">
        <option value="Funny">Funny Videos</option>
        <option value="Travel">Travel Videos</option>
        <option value="Education">Education Videos</option>
        <option value="Lifestyle">Lifestyle Videos</option>
    </select>

    <button onclick="generateIdeas()">
        Generate Ideas
    </button>

    <p id="ideas">Your ideas will appear here.</p>
</section>
<section class="card">
    <h2>📊 Video Performance Tracker</h2>

    <input id="videoName" placeholder="Video Name">

    <input id="views" type="number" placeholder="Total Views">

    <input id="likes" type="number" placeholder="Total Likes">

    <input id="comments" type="number" placeholder="Total Comments">

    <button onclick="saveVideo()">
        Save Performance
    </button>

    <div id="trackerResult" class="result">
        Your video statistics will appear here.
    </div>
</section>
    <main>
        <section class="card">
    <h2>📊 Growth Dashboard</h2>

    <h3>Total Views: <span id="totalViews">0</span></h3>

    <h3>Total Likes: <span id="totalLikes">0</span></h3>

    <h3>Total Comments: <span id="totalComments">0</span></h3>

    <h3>Engagement Rate: <span id="engagement">0%</span></h3>
</section>
        <section class="card">
            <h2>Caption Generator ✍️</h2>
            <input id="topic" placeholder="Enter video topic">
            <button onclick="generateCaption()">Generate Caption</button>
            <p id="result">Your caption will appear here.</p>
        </section>

        <section class="card">
            <h2>Hashtag Generator #️⃣</h2>
            <input id="hashtag" placeholder="Enter video category">
            <button onclick="generateHashtags()">Generate Hashtags</button>
            <p id="tags">Your hashtags will appear here.</p>
        </section>
    </main>

    <script src="script.js"></script>
</body>
</html>
